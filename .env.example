# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-only, never expose to the client)
SUPABASE_SECRET_KEY=

# Supabase Management API token, used only by setup scripts to push schema/migrations.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Gemini (server-only) - powers the AI search-brief / pool-refinement step
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# TMDB (server-only)
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# RapidAPI ott-details (server-only)
RAPID_API_KEY=
RAPID_API_HOST=ott-details.p.rapidapi.com

# Public app URL used to build QR / join links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
